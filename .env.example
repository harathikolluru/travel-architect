# ── Anthropic ──────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Places data (pick one) ─────────────────────────────
GOOGLE_PLACES_API_KEY=      # paid, rich data — recommended for demo cities
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter  # free OSM alternative

# ── Weather ────────────────────────────────────────────
# Open-Meteo is free and keyless — no variable needed
# OPENWEATHER_API_KEY=      # alternative if you prefer OpenWeatherMap

# ── Geocoding ──────────────────────────────────────────
# Nominatim (OSM) is free and keyless — no variable needed
# GOOGLE_GEOCODING_API_KEY= # alternative

# ── Database (add when Postgres is provisioned) ────────
DATABASE_URL=

# ── App ────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
