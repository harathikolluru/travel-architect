# Copy to .env and fill in. Keep comments on their own line —
# a trailing `# comment` after `KEY=` becomes part of the value.

# ── Anthropic ──────────────────────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# ── Places data ────────────────────────────────────────
# Overpass (OSM) is free and keyless and is the default source.
# Google Places is optional but much denser for attraction opening
# hours and small-town coverage — see docs/spike-data-layer.md.
# Enable "Places API (New)" in the Google Cloud project, then paste
# the key here. Leave blank to run OSM-only.
GOOGLE_PLACES_API_KEY=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# ── Weather ────────────────────────────────────────────
# Open-Meteo is free and keyless — no variable needed.

# ── Geocoding ──────────────────────────────────────────
# Nominatim (OSM) is free and keyless — no variable needed.

# ── Database ───────────────────────────────────────────
# Local dev via `npm run db:up` (docker-compose.yml)
DATABASE_URL=postgresql://travel:travel@localhost:5432/travel_architect

# ── Auth (Auth.js v5) ──────────────────────────────────
# On Azure, AUTH_SECRET and AUTH_URL are provisioned by the platform.
# Locally, generate a secret with:  npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3001

# Google — console.cloud.google.com → APIs & Services → Credentials
#   Authorised redirect URI:
#     http://localhost:3001/api/auth/callback/google
#     https://travelarchitect.apps.human-angle.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft — portal.azure.com → Entra ID → App registrations
#   Redirect URI (type "Web"):
#     http://localhost:3001/api/auth/callback/microsoft-entra-id
#     https://travelarchitect.apps.human-angle.com/api/auth/callback/microsoft-entra-id
#   Leave TENANT unset for 'common' (work + personal accounts).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT=
